end
local function get_target()
    local t = Variables.aimTarget
    if t and IsAlive(t) then
        return t
    end
    local char = LocalPlayer.Character
    if not char then
        return nil
    end
    local enemies = GetEnemies(char, true)
    if not enemies or #enemies == 0 then
        return nil
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return enemies[1]
    end
    local best, best_d = nil, math.huge
    for _, e in ipairs(enemies) do
        local ehrp = e:FindFirstChild("HumanoidRootPart")
        if ehrp then
            local d = (ehrp.Position - hrp.Position).Magnitude
            if d < best_d then
                best_d = d
                best = e
            end
        end
    end
    return best or enemies[1]
end
local function is_grounded(target)
    local hum = target:FindFirstChildOfClass("Humanoid")
    if not hum then
        return false
    end
    return hum.FloorMaterial ~= Enum.Material.Air
end
local function place_mine_at(target)
    if not is_grounded(target) then
        return
    end
    local thrp = target:FindFirstChild("HumanoidRootPart")
    if not thrp then
        return
    end
    local params = RaycastParams.new()
    local filter = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            table.insert(filter, p.Character)
        end
    end
    for _, u in ipairs(CollectionService:GetTagged("Unit")) do
        table.insert(filter, u)
    end
    local temp = Workspace:FindFirstChild("Temp")
    if temp then
        table.insert(filter, temp)
    end
    params.FilterDescendantsInstances = filter
    local r = Workspace:Raycast(thrp.Position + Vector3.new(0, 3, 0), Vector3.new(0, -10, 0), params)
    if not r then
        return
    end
    local pos = r.Position + Vector3.new(0, 0.5, 0)
    pcall(function()
        ArashMineRemote:InvokeServer(BufferPos(pos))
    end)
end
