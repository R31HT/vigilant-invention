local MY_UID = tostring(LocalPlayer.UserId)

local function count_own_mines()
    local n = 0
    for _, j in ipairs(CollectionService:GetTagged("Unit")) do
        if string.match(j.Name, "ArashMine") and string.split(j.Name, "_")[1] == MY_UID then
            n = n + 1
        end
    end
    return n
end

local function get_target()
    local t = Variables.aimTarget
    if t and IsAlive(t) then
        return t
    end
    local char = LocalPlayer.Character
    if not char then
        return nil
    end
    local enemies = GetEnemies(char, true)
    if not enemies or #enemies == 0 then
        return nil
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return enemies[1]
    end
    local best, best_d = nil, math.huge
    for _, e in ipairs(enemies) do
        local ehrp = e:FindFirstChild("HumanoidRootPart")
        if ehrp then
            local d = (ehrp.Position - hrp.Position).Magnitude
            if d < best_d then
                best_d = d
                best = e
            end
        end
    end
    return best or enemies[1]
end

local function is_grounded(target)
    local hum = target:FindFirstChildOfClass("Humanoid")
    if not hum then
        return false
    end

    return hum.FloorMaterial ~= Enum.Material.Air
end

local function place_mine_at(target)
    if not is_grounded(target) then
        return
    end
    local thrp = target:FindFirstChild("HumanoidRootPart")
    if not thrp then
        return
    end

    local params = RaycastParams.new()
    local filter = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            table.insert(filter, p.Character)
        end
    end
    for _, u in ipairs(CollectionService:GetTagged("Unit")) do
        table.insert(filter, u)
    end
    local temp = Workspace:FindFirstChild("Temp")
    if temp then
        table.insert(filter, temp)
    end
    params.FilterDescendantsInstances = filter
    local r = Workspace:Raycast(thrp.Position + Vector3.new(0, 3, 0), Vector3.new(0, -10, 0), params)
    if not r then
        return
    end
    local pos = r.Position + Vector3.new(0, 0.5, 0)
    pcall(function()
        ArashMineRemote:InvokeServer(BufferPos(pos))
    end)
end

local mine_timer = 0
connect(RunService.Heartbeat, function(dt)
    if not flags.mine_target then
        return
    end
    mine_timer = mine_timer + dt
    if mine_timer < flags.mine_target_rate then
        return
    end
    mine_timer = 0
    if count_own_mines() >= 10 then
        return
    end
    local target = get_target()
    if target then
        place_mine_at(target)
    end
end)

local function get_ult_remote()
    local c = LocalPlayer.Character
    if not c then
        return nil
    end
    local re = ReplicatedStorage:FindFirstChild("RE")
    if not re then
        return nil
    end
    local champs = re:FindFirstChild("Champions")
    if not champs then
        return nil
    end
    local f = champs:FindFirstChild(c.Name)
    if not f then
        return nil
    end
    return f:FindFirstChild("Ultimate")
end

local kill_timer = 0
connect(RunService.Heartbeat, function(dt)
    if not flags.kill then
        return
    end
    local c = LocalPlayer.Character
    if not c or not IsAlive(c) or not CanAttack(c) then
        return
    end
    local target = get_target()
    if not target or not IsAlive(target) then
        return
    end
    kill_timer = kill_timer + dt
    if kill_timer < flags.kill_rate then
        return
    end
    kill_timer = 0
    local ult = get_ult_remote()
    if ult then
        pcall(function()
            CallServer(ult, Workspace:GetServerTimeNow())
        end)
    end
end)

local function get_skill4_hit_remote()
    local c = LocalPlayer.Character
    if not c then
        return nil
    end
    local re = ReplicatedStorage:FindFirstChild("RE")
    if not re then
        return nil
    end
    local champs = re:FindFirstChild("Champions")
    if not champs then
        return nil
    end
    local f = champs:FindFirstChild(c.Name)
    if not f then
        return nil
    end
    return f:FindFirstChild("Skill4Hit")
end

local function prime_skill4_hit()
    local remote = get_skill4_hit_remote()
    if not remote then
        return
    end
    pcall(function()
        CallServer(remote, CFrame.new(), 0, {})
    end)
end

local function hit_everyone_with_skill4()
    local c = LocalPlayer.Character
    if not c or not IsAlive(c) then
        return
    end
    local remote = get_skill4_hit_remote()
    if not remote then
        return
    end
    local enemies = GetEnemies(c, true)
    if not enemies then
        return
    end
    for _, enemy in ipairs(enemies) do
        if enemy ~= c and IsAlive(enemy) then
            local ehrp = enemy:FindFirstChild("HumanoidRootPart")
            if ehrp then
                pcall(function()
                    CallServer(remote, CFrame.new(ehrp.Position), Workspace:GetServerTimeNow(), { enemy })
                end)
            end
        end
    end
end

local skill4_timer = 0
connect(RunService.Heartbeat, function(dt)
