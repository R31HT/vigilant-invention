local Mog = ReplicatedStorage:WaitForChild("RE"):WaitForChild("Mog")
local function make_call_server(suppress)
    local reported = {}
    return function(p1, ...)
        if not p1 then
            return reported
        end
        if suppress then
            if p1 == Mog then
                return
            end
            if p1:IsA("RemoteEvent") then
                p1:FireServer(...)
                return
            end
            if p1:IsA("RemoteFunction") then
                return p1:InvokeServer(...)
            end
            return
        end
        Variables.sotuff = Variables.sotuff + 1
        if not Debounce.mogged or typeof(Debounce.mogged) ~= "table" then
            if p1:IsA("RemoteEvent") then
                p1:FireServer(...)
                return
            end
            if p1:IsA("RemoteFunction") then
                return p1:InvokeServer(...)
            end
            return
        end
        local ts, reason, detail = Debounce.mogged[1], Debounce.mogged[2], Debounce.mogged[3]
        if table.find(reported, ts) then
            if p1:IsA("RemoteEvent") then
                p1:FireServer(...)
                return
            end
            if p1:IsA("RemoteFunction") then
                return p1:InvokeServer(...)
            end
            return
        end
        table.insert(reported, ts)
        if p1:IsA("RemoteEvent") then
            p1:FireServer(buffer.fromstring("mog"), buffer.fromstring(reason), buffer.fromstring(detail))
            return
        end
        if p1:IsA("RemoteFunction") then
            return p1:InvokeServer(buffer.fromstring("mog"), buffer.fromstring(reason), buffer.fromstring(detail))
        end
    end
end
local CheckAttackFn = require(PlayerScripts:WaitForChild("Client"):WaitForChild("CheckAttack"))
local AddUltimate = require(PlayerScripts:WaitForChild("Client"):WaitForChild("AddUltimate"))
local GetNested = require(Util:WaitForChild("GetNested"))
local ClientFolder = PlayerScripts:WaitForChild("Client")
local function make_check_attack(report_invalid)
    local report
    if report_invalid then
        local src = ClientFolder:FindFirstChild("AuraFarm")
        if src then
            local clone = src:Clone()
            report = require(clone)
            clone:Destroy()
        else
            report = function() end
        end
    else
        report = function() end
    end
    return function(p1)
        local idx = buffer.readu16(p1, 0)
        local pos = table.find(Variables.storedIds, idx)
        if pos then
            table.remove(Variables.storedIds, pos)
        else
            report("invalid attack", idx)
        end
        local attackName = Variables.attackIds[idx]
        local ok, gain = pcall(function()
            return buffer.readi8(p1, 2)
        end)
        if ok and gain then
            if gain < 0 then
                gain = math.abs(gain) / 10
            end
            AddUltimate(gain)
            if gain > 0 then
                local char = LocalPlayer.Character
                if char and attackName then
                    pcall(function()
                        local hs = GetNested({ PlayerScripts, "Client", "Champions", char.Name, attackName .. "HitSuccess" })
                        if hs then
                            require(hs)()
                        end
                    end)
                end
            end
        end
    end
end
local function apply_anticheat()
    pcall(function()
        hookfunction(CallServer, make_call_server(true))
    end)
    pcall(function()
        hookfunction(CheckAttackFn, make_check_attack(false))
    end)
end
