local function get_basic_attack_idx()
    local ids = Variables.attackIds
    if not ids or #ids == 0 then
        return nil
    end
    local name = LocalPlayer.Character and LocalPlayer.Character.Name
    if name then
        local aliases = { name }
        if name == "Senthe" then
            table.insert(aliases, "Seth")
        elseif name == "Seth" then
            table.insert(aliases, "Senthe")
        end
        for _, alias in ipairs(aliases) do
            for _, suf in ipairs({ "Basic1", "Basic2", "Basic" }) do
                for i, n in ipairs(ids) do
                    if n == alias .. suf then
                        return i
                    end
                end
            end
        end
    end
    for i, n in ipairs(ids) do
        if n:match("Basic") then
            return i
        end
    end
    return nil
end
local function kill_aura_burst(target, cframe, idx)
    for _ = 1, flags.kill_aura_hits do
        local b = buffer.create(2)
        buffer.writeu16(b, 0, idx)
        pcall(DamageRequestFn, { b, Workspace:GetServerTimeNow(), cframe, target }, true)
    end
end
local KILL_AURA_COOLDOWN = 0.4
local KILL_AURA_MAX_PENDING = 120
local kill_aura_timer = 0
connect(RunService.Heartbeat, function(dt)
    if not flags.kill_aura then
        return
    end
    kill_aura_timer = kill_aura_timer - dt
    if kill_aura_timer > 0 then
        return
    end
    if #Variables.storedIds > KILL_AURA_MAX_PENDING then
        table.clear(Variables.storedIds)
    end
    local c = LocalPlayer.Character
    if not c or not IsAlive(c) or not CanAttack(c) then
        return
    end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return
    end
    local idx = get_basic_attack_idx()
    if not idx then
        return
    end
    local enemies = GetEnemies(c, true)
    if not enemies then
        return
    end
    local r2 = flags.kill_aura_radius * flags.kill_aura_radius
    local origin = hrp.Position
    local cframe = hrp.CFrame
    local hits = 0
    for _, e in ipairs(enemies) do
        if e ~= c and IsAlive(e) then
            local ehrp = e:FindFirstChild("HumanoidRootPart")
            if ehrp then
                local o = ehrp.Position - origin
                if o.X * o.X + o.Y * o.Y + o.Z * o.Z <= r2 then
                    kill_aura_burst(e, cframe, idx)
                    hits = hits + 1
                end
            end
        end
    end
    if hits > 0 then
        kill_aura_timer = KILL_AURA_COOLDOWN
    end
end)
