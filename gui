local cleanups = {}
local conns = {}
local function onCleanup(fn)
    table.insert(cleanups, fn)
end
local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(conns, c)
    return c
end
local function cleanup()
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    for _, fn in ipairs(cleanups) do
        pcall(fn)
    end
    conns = {}
    cleanups = {}
end
getgenv().ENCOUNTERS_HUB = { cleanup = cleanup }

if STATE and STATE.onCleanup then
    STATE.onCleanup(cleanup)
end

local CONFIG_FILE = "encounters_hub_config.json"

local flags = {
    inf_energy = false,
    inf_ult = false,
    no_cooldown = false,
    godmode = false,
    mine_target = false,

    mine_target_rate = 0.3,
    kill = false,

    kill_rate = 0.2,
    skill4_everyone = false,

    skill4_rate = 0.2,
}

local function load_config()
    if not isfile(CONFIG_FILE) then
        return {}
    end
    local ok, raw = pcall(readfile, CONFIG_FILE)
    if not ok or not raw or raw == "" then
        return {}
    end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or typeof(data) ~= "table" then
        return {}
    end
    return data
end

local function save_config()
    local snap = {
        inf_energy = flags.inf_energy,
        inf_ult = flags.inf_ult,
        no_cooldown = flags.no_cooldown,
        godmode = flags.godmode,
        mine_target = flags.mine_target,
        mine_target_rate = flags.mine_target_rate,
        kill = flags.kill,
        kill_rate = flags.kill_rate,
        skill4_everyone = flags.skill4_everyone,
        skill4_rate = flags.skill4_rate,
    }
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(snap))
    end)
end

do
